{
  "name": "plotline",
  "displayName": "Plotline",
  "description": "A creative writing extension for Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "plotline-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "plotline.helloWorld",
        "title": "Plotline: Hello World"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint src test",
    "compile": "npm run typecheck && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test:unit": "vitest run",
    "test:integration": "npm run compile && tsc -p ./ && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
